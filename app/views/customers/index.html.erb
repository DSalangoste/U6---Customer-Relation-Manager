<div class="container">
  <h1>All Customers</h1>

  <div class="navigation-links">
    <%= link_to "View Missing Emails", missing_email_customers_path %>
    <%= link_to "View Alphabetized", alphabetized_customers_path %>
  </div>

  <div class="customers-list">
    <% @customers.each do |customer| %>
      <%= render 'customer', customer: customer %>
    <% end %>
  </div>
</div>
